# Dependencies (FeatureLens has none, but tools may create this)
node_modules/

# Logs and coverage
*.log
npm-debug.log*
coverage/
.nyc_output/

# Package archives from `npm pack`
*.tgz

# Environment and credentials
.env
.env.*
*.pem
*.key

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local Claude Code settings
.claude/settings.local.json

# Temporary files
*.tmp
tmp/
.tmp/

# Local evaluation and scratch work: keep these outside the repository, or
# here. eval/run.js --out and --express take any directory.
scratch/
.scratch/
eval-out/
eval/out/
eval/repos/

# Documents generated by rendering the bundled example in place
examples/sample-shop/docs/
