    "findings": [
      {
        "id": "f-overview",
        "section": "overview",
        "title": "Synchronous charge-then-record flow",
        "body": "Paying an order runs in a single request: the order is loaded and checked, the card is charged through the gateway, a payment row is written, and the order is marked paid only if the charge succeeded.",
        "certainty": "observed",
        "evidence": [
          "ev-pay-order"
        ]
      },
      {
        "id": "f-guards",
        "section": "implementation",
        "title": "Only pending orders can be paid",
        "body": "Missing orders return ORDER_NOT_FOUND and orders whose status is not 'pending' return ORDER_NOT_PAYABLE before any gateway call is made.",
        "certainty": "observed",
        "evidence": [
          "ev-order-guards"
        ]
      },
      {
        "id": "f-failed-recorded",
        "section": "implementation",
        "title": "Declined charges are persisted",
        "body": "A payment row is written for both successful and declined charges, with status 'captured' or 'failed'.",
        "certainty": "observed",
        "evidence": [
