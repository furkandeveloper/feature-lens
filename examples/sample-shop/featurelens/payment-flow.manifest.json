    "risks": [
      {
        "id": "risk-no-transaction",
        "title": "Charge can succeed while the order stays pending",
        "body": "The gateway charge, payment insert and order update are separate awaited calls with no transaction or compensation. If insert or updateStatus throws after a successful charge, the customer is charged but the order is not marked paid.",
        "severity": "high",
        "certainty": "inferred",
        "evidence": [
          "ev-charge-call",
          "ev-payment-insert",
          "ev-mark-paid"
        ]
      },
      {
        "id": "risk-double-charge",
        "title": "No idempotency on repeated requests",
        "body": "Two concurrent requests for the same pending order can both pass the status check and both charge the card; no idempotency key or lock is visible.",
        "severity": "high",
        "certainty": "inferred",
        "evidence": [
          "ev-order-guards",
          "ev-charge-call"
        ]
      }
    ],
